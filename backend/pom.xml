<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- The pinned JDK, the toolchain, the licence header check and the Spring
         Modulith BOM all live in the root POM, so they are declared once for the
         whole reactor instead of once per project. -->
    <parent>
        <groupId>com.lineward</groupId>
        <artifactId>lineward-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>lineward</artifactId>
    <name>lineward</name>
    <description>Identity Governance platform: the governance core</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-core</artifactId>
        </dependency>

        <!-- Versions come from the Spring Boot BOM, verified 2026-10-14 against
             spring-boot-dependencies-4.1.1: Flyway 12.4.0, PostgreSQL driver
             42.7.13, Testcontainers 2.0.5. They match ADR-006, so nothing is
             declared here: overriding a managed version breaks the
             compatibility guarantee the BOM exists to provide. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <!-- Spring Boot 4 split autoconfiguration into one module per
             technology, so flyway-core on its own is NOT enough: the
             application starts, says nothing and never migrates. This module is
             what configures Flyway, and it brings flyway-core with it.
             Diagnosed 2026-10-14 by starting the application and finding an
             empty database. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <!-- Since Flyway 10, database support lives in separate modules and
             flyway-core alone does not recognise PostgreSQL. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Section 10.1 requires integration tests against real
             infrastructure. An in-memory database cannot test row level
             security, which is the whole isolation mechanism of ADR-011. -->
        <!-- Testcontainers 2.x renamed every module: these were
             org.testcontainers:postgresql and :junit-jupiter in 1.x, which is
             what every published example still shows. Verified 2026-10-14
             against testcontainers-bom 2.0.5. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Declared here and not in the root POM: this module is an
                 executable application, and the generator library must not be
                 repackaged into a fat jar. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
