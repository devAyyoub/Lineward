# The directory the LDAP connector of KAN-8 reads.
#
# Loaded on first start by the image, which runs ldapadd over a local socket as
# the admin account. It runs once: the marker lives in the data volume, so
# changing this file afterwards does nothing until the volume is wiped.
#
# There is no password anywhere in this file, and that is not an omission.
# Nobody binds as these accounts: Lineward reads the directory with a service
# account of its own, which infra/ldap/init/01-access-rules.sh creates from an
# environment variable because a committed password is a committed password
# whatever it protects.
#
# The group names are not free either. V003 seeded the catalogue of the
# corporate directory with thirteen distinguished names, and a distinguished
# name is what a connector reports as the native value of a permission, so these
# thirteen are character for character the ones already in the database. Letting
# them differ would make every one of them read as drift the first time the two
# are compared.

# The root of the tree, which this file has to create itself. The image is
# started with LDAP_SKIP_DEFAULT_TREE so that nothing but this file decides what
# the directory contains, and that switch skips the suffix entry too, not only
# the sample users: without the entry below, the first line of this file fails
# with "No such object" and the container exits. Verified on 2.6.10.
dn: dc=lineward,dc=example
objectClass: dcObject
objectClass: organization
dc: lineward
o: Lineward

dn: ou=users,dc=lineward,dc=example
objectClass: organizationalUnit
ou: users

dn: ou=groups,dc=lineward,dc=example
objectClass: organizationalUnit
ou: groups


# Staff. The login name is the uid and the employee number is employeeNumber:
# two different things, and the correlation of KAN-11 matches on the second.
# Both employeeNumber and departmentNumber are standard attributes of
# inetOrgPerson (RFC 2798), so this needs no schema extension.

dn: uid=a.ferrero,ou=users,dc=lineward,dc=example
objectClass: inetOrgPerson
uid: a.ferrero
cn: Alba Ferrero
sn: Ferrero
displayName: Alba Ferrero
mail: alba.ferrero@lineward.example
employeeNumber: E-0001
departmentNumber: Treasury

dn: uid=b.novak,ou=users,dc=lineward,dc=example
objectClass: inetOrgPerson
uid: b.novak
cn: Borna Novak
sn: Novak
displayName: Borna Novak
mail: borna.novak@lineward.example
# A second address, because an attribute in a directory is multi valued by
# definition and this is the one place a reader notices. A field that holds one
# string keeps the first value and drops the rest without saying so.
mail: b.novak@lineward.example
employeeNumber: E-0002
departmentNumber: Engineering

