departmentNumber: Legal and Compliance
# Locked, so that a read has one account that is not simply active. OpenLDAP has
# no "switched off" flag of its own; what it has is this, the lock the password
# policy overlay keeps, which is why the connector reports LOCKED and never
# DISABLED. The overlay has to be configured for the attribute to exist at all:
# without it the directory rejects this line with "attribute type undefined".
pwdAccountLockedTime: 20261001090000Z

dn: uid=j.adeyemi,ou=users,dc=lineward,dc=example
objectClass: inetOrgPerson
uid: j.adeyemi
cn: Jumoke Adeyemi
sn: Adeyemi
displayName: Jumoke Adeyemi
mail: jumoke.adeyemi@lineward.example
employeeNumber: E-0010
departmentNumber: Internal Audit


# Two entries that are here to be awkward, because a directory that has been
# alive for fifteen years has entries like these and a fixture that does not
# proves nothing.
#
# The first is named by its cn and not by a uid, which happens whenever a
# directory has survived a migration, and its name carries brackets and an
# apostrophe. Those are not decoration: the connector asks which groups hold an
# account by searching for its distinguished name, and a name with a bracket in
# it breaks an LDAP filter that was built by pasting strings together.
#
# The second has a name that was truncated by whatever moved it here, so its
# bracket never closes. That is legal in a distinguished name and it is not
# legal in a search filter: asking which groups hold this account by pasting its
# name into a filter makes the whole filter unparseable, and the server rejects
# it with "Bad search filter". Measured on 2.6.10 on 2026-11-03, along with the
# thing that is NOT true and was worth checking: an asterisk in a name widens
# nothing here, because member holds distinguished names and LDAP defines no
# substring matching for those. It also has no employee number and belongs to no
# group: a leftover service account owned by nobody, which is the shape of the
# orphan a first aggregation is run to find.

dn: cn=K. O'Hara (contractor),ou=users,dc=lineward,dc=example
objectClass: inetOrgPerson
cn: K. O'Hara (contractor)
sn: O'Hara
departmentNumber: Engineering

dn: cn=svc-payroll (2011,ou=users,dc=lineward,dc=example
objectClass: inetOrgPerson
cn: svc-payroll (2011
sn: Payroll import job
description: Batch account from the 2011 payroll migration. Name truncated by it. Owner unknown.


# The catalogue. Membership lives here, on the group, in the member attribute:
# OpenLDAP does not put memberOf on an account unless an overlay is configured
# to maintain it, and this directory deliberately does not configure one, so
# that the connector is exercised against the shape every directory has.

dn: cn=all-staff,ou=groups,dc=lineward,dc=example
objectClass: groupOfNames
cn: all-staff
description: Every active member of staff. The base package nobody requests.
member: uid=a.ferrero,ou=users,dc=lineward,dc=example
