# Copy to .env to override the local development defaults in docker-compose.yml.
# .env is git-ignored. These values are for a local machine only.
POSTGRES_SUPERUSER_PASSWORD=postgres_local
LINEWARD_DB=lineward
LINEWARD_OWNER_USER=lineward_owner
LINEWARD_OWNER_PASSWORD=lineward_owner_local
LINEWARD_APP_USER=lineward_app
LINEWARD_APP_PASSWORD=lineward_app_local
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak_local
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin_local
# The secret of the read-only client the connector reads the lineward realm
# with. It reaches Keycloak as an environment variable, which the realm import
# substitutes into ${LINEWARD_AGGREGATOR_SECRET}, so no secret is ever committed.
# Changing it after the realm has been imported once has no effect: a realm
# import is IGNORE_EXISTING, so delete the realm first.
LINEWARD_AGGREGATOR_SECRET=aggregator_local
# The directory Lineward aggregates. The password below is the account the
# connector reads with: the committed tree holds no password at all, and the
# init script creates that account from this variable. Changing it after the
# directory has started once has no effect, because the data directory keeps a
# marker: docker compose down -v first.
LINEWARD_LDAP_ROOT=dc=lineward,dc=example
LINEWARD_LDAP_ADMIN_USER=admin
LINEWARD_LDAP_ADMIN_PASSWORD=ldap_admin_local
LINEWARD_LDAP_READER_PASSWORD=ldap_reader_local
LINEWARD_DB_PORT=5434
KEYCLOAK_PORT=8081
LINEWARD_LDAP_PORT=1389
